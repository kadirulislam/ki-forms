{
  "name": "ki-forms",
  "version": "2.1.0",
  "description": "Build dynamic React forms from JSON with zero setup.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./zod": {
      "types": "./dist/ki-forms-zod.d.ts",
      "import": "./dist/ki-forms-zod.js",
      "require": "./dist/ki-forms-zod.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/ki-forms-zod.ts --format esm,cjs --dts --external zod",
    "dev": "tsup src/index.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "demo": "vite demo",
    "demo:build": "vite build --config vite.demo.config.ts",
    "studio": "vite studio",
    "studio:build": "vite build --config vite.studio.config.ts",
    "pages:build": "npm run demo:build && npm run studio:build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "react forms",
    "dynamic forms",
    "json forms",
    "react form builder",
    "nextjs forms",
    "form generator"
  ],
  "author": "Kadirul Islam",
  "license": "MIT",
  "homepage": "https://kadirulislam.github.io/ki-forms/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kadirulislam/ki-forms"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "zod": "^3 || ^4"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^30.1.0",
    "lucide-react": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
