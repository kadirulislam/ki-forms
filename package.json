{
  "name": "ki-forms",
  "version": "2.0.0",
  "description": "Build dynamic React forms from JSON with zero setup.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
      "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "react forms",
    "dynamic forms",
    "json forms",
    "react form builder",
    "nextjs forms",
    "form generator"
  ],
  "author": "Kadirul Islam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kadirulislam/ki-forms"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
